if __name__ == "__main__":
    print("🤖 Бот запущен...")
    print(f"👥 Админы: {ADMIN_IDS}")
    print(f"💳 Platega: {'✅ ВКЛЮЧЕНА' if is_platega_enabled() else '❌ НЕ НАСТРОЕНА (только баланс)'}")
    print("📋 Номера заказов: PREFIX-YYMMDD-XXXXXX")
    if not is_platega_enabled():
        print("💡 Заполните PLATEGA_API_KEY, PLATEGA_SHOP_ID, PLATEGA_SECRET_KEY чтобы включить оплату картой")
    bot.polling(none_stop=True)
